# Copy to deploy/.env on the server and fill in. Never commit deploy/.env.

# The site's address. With no domain of your own, use the server's IP with
# dashes instead of dots plus .sslip.io, e.g. 15-222-1-2.sslip.io. Use ":80"
# to try it on your own computer over plain HTTP.
WALKER_DOMAIN=15-222-1-2.sslip.io

# Must include the address above (without https://).
DJANGO_ALLOWED_HOSTS=15-222-1-2.sslip.io

# A long random secret. Make one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

DJANGO_DEBUG=false
