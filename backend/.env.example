# Copy to .env for local development. Never commit .env.
DJANGO_DEBUG=true
# Required when DJANGO_DEBUG is false.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Graph file built by `uv run python -m graph.build`. Defaults to data/downtown.walkgraph.
# WALKER_GRAPH_PATH=
# Place search provider: "photon", or a dotted path to another geocoder class.
# WALKER_GEOCODER=photon
# WALKER_PHOTON_URL=https://photon.komoot.io
